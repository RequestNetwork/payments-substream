# Shell KEY=VALUE defaults sourced by the bash supervisor (sinks/supervisor.sh), one block per
# chain. Plain KEY=VALUE only, so any POSIX shell can source it.
# <CHAIN> is the chain name uppercased, hyphens converted to underscores.
#
# No secrets here -- SUBSTREAMS_API_TOKEN (and SUBSTREAMS_API_TOKEN_ALT) are read from the
# environment named by <CHAIN>_TOKEN_ENV, never written as a value in this file.
#
# <CHAIN>_SPKG      which package the supervisor loads: tron (tron/) or evm (evm/)
# <CHAIN>_NETWORK   substreams `network:` value for this chain
# <CHAIN>_ENDPOINT  StreamingFast endpoint; commented Pinax alternative where one exists
#                   (no Pinax endpoint for optimism or tron)
# <CHAIN>_SCHEMA    Postgres schema (DSN schemaName=)
# <CHAIN>_TOKEN_ENV name of the environment variable holding the StreamingFast/Pinax API token
# <CHAIN>_UNDO_BUFFER_SIZE confirmation depth in blocks: the sink writes a block's rows only once
#                   it is this deep, so payments in blocks later reorged out never reach the
#                   database (this disables the sink's in-database reorg undo). Detection latency
#                   grows by about depth x block time. Override per env with
#                   SINK_UNDO_BUFFER_SIZE_<CHAIN>.
#
# These are DEFAULTS only. For each <FIELD> above the supervisor resolves
#   SINK_<FIELD>_<CHAIN> (runtime override) -> <CHAIN>_<FIELD> (this file) -> error
# (see docs/contract.md "Defaults and resolution order").
#
# No params are set here either: module params come from the manifests (the `params:` block of
# tron/substreams.yaml; the per-network `networks:` section of evm/substreams.yaml, selected with
# --network). SINK_PARAMS_<CHAIN> is a runtime override only.
#
# No start block is set here: each module starts at its per-network initialBlock in the
# manifest (evm/substreams.yaml networks:, tron/substreams.yaml initialBlock: 79216121) when its
# schema has no cursor. SINK_START_BLOCK_<CHAIN> is only for replays / recent windows. There is
# deliberately no <CHAIN>_INITIAL_BLOCK copy here -- the manifest is authoritative.

MAINNET_SPKG=evm
MAINNET_NETWORK=mainnet
MAINNET_ENDPOINT=mainnet.eth.streamingfast.io:443
# Pinax alternative: eth.substreams.pinax.network:443
MAINNET_SCHEMA=mainnet
MAINNET_TOKEN_ENV=SUBSTREAMS_API_TOKEN
MAINNET_UNDO_BUFFER_SIZE=12

SEPOLIA_SPKG=evm
SEPOLIA_NETWORK=sepolia
SEPOLIA_ENDPOINT=sepolia.eth.streamingfast.io:443
# Pinax alternative: sepolia.substreams.pinax.network:443
SEPOLIA_SCHEMA=sepolia
SEPOLIA_TOKEN_ENV=SUBSTREAMS_API_TOKEN
SEPOLIA_UNDO_BUFFER_SIZE=12

MATIC_SPKG=evm
MATIC_NETWORK=polygon
MATIC_ENDPOINT=polygon.streamingfast.io:443
# Pinax alternative: polygon.substreams.pinax.network:443
MATIC_SCHEMA=matic
MATIC_TOKEN_ENV=SUBSTREAMS_API_TOKEN
MATIC_UNDO_BUFFER_SIZE=64

ARBITRUM_ONE_SPKG=evm
ARBITRUM_ONE_NETWORK=arbitrum-one
ARBITRUM_ONE_ENDPOINT=arb-one.streamingfast.io:443
# Pinax alternative: arbone.substreams.pinax.network:443
ARBITRUM_ONE_SCHEMA=arbitrum_one
ARBITRUM_ONE_TOKEN_ENV=SUBSTREAMS_API_TOKEN
ARBITRUM_ONE_UNDO_BUFFER_SIZE=40

BSC_SPKG=evm
BSC_NETWORK=bsc
BSC_ENDPOINT=bnb.streamingfast.io:443
# Pinax alternative: bsc.substreams.pinax.network:443
BSC_SCHEMA=bsc
BSC_TOKEN_ENV=SUBSTREAMS_API_TOKEN
BSC_UNDO_BUFFER_SIZE=15

OPTIMISM_SPKG=evm
OPTIMISM_NETWORK=optimism
OPTIMISM_ENDPOINT=mainnet.optimism.streamingfast.io:443
# No Pinax endpoint for optimism
OPTIMISM_SCHEMA=optimism
OPTIMISM_TOKEN_ENV=SUBSTREAMS_API_TOKEN
OPTIMISM_UNDO_BUFFER_SIZE=20

BASE_SPKG=evm
BASE_NETWORK=base
BASE_ENDPOINT=base-mainnet.streamingfast.io:443
# Pinax alternative: base.substreams.pinax.network:443
BASE_SCHEMA=base
BASE_TOKEN_ENV=SUBSTREAMS_API_TOKEN
BASE_UNDO_BUFFER_SIZE=20

TRON_SPKG=tron
TRON_NETWORK=tron
TRON_ENDPOINT=mainnet.tron.streamingfast.io:443
# No Pinax endpoint for tron
TRON_SCHEMA=tron
TRON_TOKEN_ENV=SUBSTREAMS_API_TOKEN
TRON_UNDO_BUFFER_SIZE=20
